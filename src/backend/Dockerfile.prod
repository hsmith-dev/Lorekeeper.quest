FROM python:3.11-slim
WORKDIR /app

# Pango, HarfBuzz, fontconfig and DejaVu are WeasyPrint's system libraries and
# font for the campaign PDF export (E0-QA.9). fonts-dejavu-extra has the
# oblique faces: WeasyPrint does not synthesise italics. No compiler and no
# libpq: every requirement ships a binary wheel on amd64 and arm64, and
# asyncpg speaks the Postgres protocol itself.
RUN apt-get update && apt-get install -y --no-install-recommends \
        libpango-1.0-0 libpangoft2-1.0-0 libharfbuzz0b fontconfig fonts-dejavu-core fonts-dejavu-extra \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
# No model packages (E0-Platform.6): embeddings, NER and OCR come from the ml
# sidecar, speech from stt, so the web and worker processes load no model.
# CI-3 (scripts/check_model_packages.py, also run on this image's pip list)
# fails if torch, spaCy or another model package comes back.
RUN pip install --no-cache-dir -r requirements.txt

COPY . .

# Non-root user for security. /var/log/lorekeeper must exist and be owned by
# appuser IN THE IMAGE: a fresh named volume mounted there (backend_logs in
# docker-compose.prod.yml) copies this ownership on first use — without it
# the volume comes up root-owned and the LOG_FILE handler silently can't
# write (the admin log viewer then falls back to per-worker memory buffers).
# /data/files (the files_data volume, E0-Jobs.8) likewise: the backend and the
# worker write stored files there as appuser. Files are created 0644 and
# directories 0755 (the default umask) so nginx can serve them read-only.
RUN useradd -m appuser && chown -R appuser /app \
    && mkdir -p /var/log/lorekeeper && chown appuser /var/log/lorekeeper \
    && mkdir -p /data/files && chown appuser /data/files
USER appuser

EXPOSE 8000

# 4 workers; tune -w based on CPU cores (2 × cores + 1 is a common rule)
CMD ["gunicorn", "app.main:app", \
     "-w", "4", \
     "-k", "uvicorn.workers.UvicornWorker", \
     "--bind", "0.0.0.0:8000", \
     "--timeout", "180", \
     "--graceful-timeout", "30", \
     "--keep-alive", "5", \
     "--access-logfile", "-", \
     "--error-logfile", "-"]
