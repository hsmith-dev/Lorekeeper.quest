FROM python:3.11-slim
WORKDIR /app

# System deps for spaCy/asyncpg. build-essential (not just gcc) — on x86_64
# pip finds prebuilt manylinux wheels for spaCy's C extensions and never
# compiles anything, so bare gcc went unnoticed; on ARM64 no prebuilt wheel
# exists for this spaCy version, pip falls back to a source build, and that
# needs full libc headers (stdlib.h etc.) that gcc alone doesn't pull in —
# confirmed by an actual `docker buildx build --platform linux/arm64` run
# failing with "fatal error: stdlib.h: No such file or directory" before this
# fix.
RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential libpq-dev \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
# CPU-only torch/torchvision first (E0-Platform.2): a plain PyPI resolve on
# x86-64 pulls CUDA torch and ~15 NVIDIA-proprietary nvidia-*/cuda-* wheels.
# The CPU index has +cpu wheels for amd64 and arm64 alike. Pins match
# licenses/register.yaml; the requirements install then uses the same CPU
# extra index as CI's licence job.
RUN pip install --no-cache-dir --index-url https://download.pytorch.org/whl/cpu \
        torch==2.15.0+cpu torchvision==0.29.2+cpu
RUN pip install --no-cache-dir --extra-index-url https://download.pytorch.org/whl/cpu \
        -r requirements.txt

# spaCy model — downloaded at build time so it's baked into the image
RUN python -m spacy download en_core_web_trf

# Fail the build if any earlier layer re-resolved torch to CUDA or added NVIDIA wheels
RUN python -c "import torch, sys; sys.exit(torch.version.cuda is not None or torch.cuda.is_available())" \
    && ! pip list --format=freeze | grep -iE '^(nvidia|cuda)[-_]'

COPY . .

# Non-root user for security. /var/log/lorekeeper must exist and be owned by
# appuser IN THE IMAGE: a fresh named volume mounted there (backend_logs in
# docker-compose.prod.yml) copies this ownership on first use — without it
# the volume comes up root-owned and the LOG_FILE handler silently can't
# write (the admin log viewer then falls back to per-worker memory buffers).
RUN useradd -m appuser && chown -R appuser /app \
    && mkdir -p /var/log/lorekeeper && chown appuser /var/log/lorekeeper
USER appuser

EXPOSE 8000

# 4 workers; tune -w based on CPU cores (2 × cores + 1 is a common rule)
CMD ["gunicorn", "app.main:app", \
     "-w", "4", \
     "-k", "uvicorn.workers.UvicornWorker", \
     "--bind", "0.0.0.0:8000", \
     "--timeout", "180", \
     "--graceful-timeout", "30", \
     "--keep-alive", "5", \
     "--access-logfile", "-", \
     "--error-logfile", "-"]
