# =============================================================================
# Lorekeeper — Environment Variables
# Copy this file to .env before starting the app: `cp .env.example .env`
#
# Defaults below are for the STANDARD SELF-HOSTED SETUP — the full Docker
# Compose stack (docker-compose.prod.yml), where postgres/valkey/ollama are
# sibling containers reached by their service names. If that's you, the only
# things you MUST change are:
#   1. SECRET_KEY        (generate with: openssl rand -hex 32)
#   2. POSTGRES_PASSWORD (pick anything strong; keep it in DATABASE_URL too)
# The FIRST account registered on a fresh deployment automatically becomes
# the admin — register yourself before sharing the URL.
#
# Running the backend directly on your machine for development instead? Use
# the "local dev" alternatives noted next to each service below.
# =============================================================================

# ── Database ──────────────────────────────────────────────────────────────────
# Compose stack: host is the `postgres` service name. Local dev: localhost.
# The password here MUST match POSTGRES_PASSWORD below.
# Requires PostgreSQL 15+ (16 recommended; bundled as pgvector/pgvector:pg16).
# An older server is refused at boot by the F3-world migration.
DATABASE_URL=postgresql+asyncpg://lorekeeper:changeme@postgres:5432/lorekeeper
POSTGRES_USER=lorekeeper
POSTGRES_PASSWORD=changeme
POSTGRES_DB=lorekeeper
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ── Valkey ────────────────────────────────────────────────────────────────────
# Valkey (BSD-3-Clause) is the Redis-compatible key-value server: cache,
# dedup, the LLM priority gate. Compose stack: the `valkey` service (this is
# also the default when unset). Local dev: redis://localhost:6379/0
# The scheme stays redis:// on purpose: it is the wire protocol, and the
# redis-py client doesn't accept valkey://.
# REDIS_URL is the old name: still read when VALKEY_URL is unset, with a
# deprecation warning in the backend log. Rename it to VALKEY_URL.
VALKEY_URL=redis://valkey:6379/0

# ── Auth (generate with: openssl rand -hex 32) ────────────────────────────────
SECRET_KEY=REPLACE_WITH_SECURE_RANDOM_KEY
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── Default LLM (users can override per-account in Settings) ──────────────────
# The compose stack ships an Ollama container at http://ollama:11434 — leave
# this as-is and install the model from Admin → System after first login.
# Despite the name, KOBOLD_URL just needs an OpenAI-compatible
# chat-completions endpoint (or KoboldCpp's native API), so alternatives work:
#   - KoboldCpp/Ollama on the Docker HOST machine (e.g. your GPU desktop):
#     KOBOLD_URL=http://host.docker.internal:11434   (Ollama; KoboldCpp: :5001)
#     `web` and `worker` resolve host.docker.internal through extra_hosts
#     (host-gateway). Keep the bundled one stopped on EVERY `up`: pass
#     `--scale ollama=0` each time, or put `ollama: deploy: replicas: 0` in a
#     docker-compose.override.yml (README, "Ollama already running on the
#     host"). Run the host Ollama with OLLAMA_CONTEXT_LENGTH=4096,
#     OLLAMA_NUM_PARALLEL=1 and OLLAMA_MAX_LOADED_MODELS=1, as the stack does.
#     OLLAMA_MEM_LIMIT's 5.25g still counts: the host's own Ollama uses at
#     least that much of the same 16 GB.
#   - Local dev outside Docker: KOBOLD_URL=http://localhost:11434
# If you run neither, users can configure OpenAI / Anthropic / Gemini keys
# from their account Settings page instead.
KOBOLD_URL=http://ollama:11434
# Generous timeout: a 7B model on CPU can legitimately take several minutes on
# long generations (chat and journal answers of 500-800 tokens). 1200s (20 min)
# leaves headroom on modest CPUs; nginx's proxy timeout is set just above it.
# With a GPU, replies are seconds and this never matters.
KOBOLD_TIMEOUT_SECONDS=1200
KOBOLD_MAX_LENGTH=800
KOBOLD_TEMPERATURE=0.72
KOBOLD_TOP_P=0.95
# CPU cores the bundled ollama container may use (docker-compose.prod.yml).
# 0 = no cap, all cores (default; generation speed scales with cores). Set e.g.
# OLLAMA_CPUS=6 to leave cores free for other work on a shared machine.
# A cap needs a matching thread count: Ollama starts one thread per HOST core
# whatever the container's CPU quota, and the throttled threads stall each
# other (E0-QA.15: 0.7 tok/s at cpus 3 with 12 threads, 6 tok/s with
# num_thread 3). With OLLAMA_CPUS=N, re-create the model with
# `PARAMETER num_thread N` in its Modelfile (docs/BENCHMARKS.md, "CPU cap").
OLLAMA_CPUS=0

# ── Memory budget (AD-7: one 16 GB profile) ───────────────────────────────────
# Container memory limits for docker-compose.prod.yml, each used as that
# service's deploy.resources.limits.memory. They add up to exactly 14.5 GiB,
# leaving 1.5 GB of a 16 GB box for the OS and Docker; CI fails if the sum
# goes over (scripts/check_memory_budget.py, CI-14). Docker sizes are binary
# (1g = 1024m). To raise one, lower another by the same amount.
# TTS_MEM_LIMIT is reserved for the AGPL `tts` service (E5), so the sum stays
# true when it lands. The optional `diarize` profile is outside the sum.
# The GPU override (docker-compose.gpu.yml) changes no limit.
OLLAMA_MEM_LIMIT=5.25g
ML_MEM_LIMIT=2.5g
TTS_MEM_LIMIT=2.5g
STT_MEM_LIMIT=1.25g
WEB_MEM_LIMIT=1g
WORKER_MEM_LIMIT=1g
POSTGRES_MEM_LIMIT=768m
VALKEY_MEM_LIMIT=128m
NGINX_MEM_LIMIT=128m

# ── ml sidecar (embeddings, NER, NLI, OCR) ────────────────────────────────────
# The `ml` compose service, reachable only on the internal `models` network.
# Defaults are right for both compose files; local dev outside Docker with the
# sidecar run by hand: ML_URL=http://localhost:8001 (whatever port you pick).
# ML_URL=http://ml:8000
# ML_TIMEOUT_S=30
# Read timeout for NER calls (en_core_web_trf on CPU is slow; NPC extract sends up to 20k chars).
# ML_NER_TIMEOUT_S=120
# The container's memory ceiling is ML_MEM_LIMIT (Memory budget, above).
# Resident-memory budget (declared MB) for the lazily loaded NLI and OCR
# models; over it, idle ones are evicted or the request gets 503 ml_budget.
# ML_RESIDENT_BUDGET_MB=2000
# Declared cost (MB) of each lazy model against that budget; provisional
# until the desktop run measures them.
# ML_NLI_COST_MB=600
# ML_OCR_COST_MB=400

# ── Job worker ────────────────────────────────────────────────────────────────
# The `worker` compose service (python -m app.jobs.worker, E0-Jobs.3): how
# many LorekeeperWorker processes its RQ WorkerPool runs. Its memory ceiling
# is WORKER_MEM_LIMIT (Memory budget, above; both compose files).
# WORKER_PROCESSES=2

# ── stt sidecar (speech-to-text, faster-whisper) ──────────────────────────────
# The `stt` compose service, also only on the internal `models` network; voice
# upload (/api/ingest/voice) goes through it. Defaults are right for both
# compose files. STT_COMPUTE_TYPE is read by the backend and passed by compose
# to the sidecar: int8 (default, smallest and fastest on CPU) or float32
# (float16 / int8_float16 only for a GPU build).
# STT_IDLE_UNLOAD_S: seconds idle before the model is dropped (0 = never).
# Outside compose (a natively run backend; docker-compose.dev.yml has no stt
# service) voice upload answers 503 until you run the sidecar yourself:
#   docker build -t lorekeeper-stt src/services/stt
#   docker run --rm -p 127.0.0.1:8002:8000 lorekeeper-stt
# and set STT_URL=http://localhost:8002.
# STT_URL=http://stt:8000
# STT_TIMEOUT_S=300
# STT_COMPUTE_TYPE=int8
# STT_IDLE_UNLOAD_S=600
# STT_CPU_THREADS=2
# Its memory ceiling is STT_MEM_LIMIT (Memory budget, above).
# GPU override only (docker-compose.gpu.yml): the compute type the GPU stt
# build runs with. float16 is what E0-QA.15 measured on the RTX 5080.
# STT_GPU_COMPUTE_TYPE=float16

# ── App ───────────────────────────────────────────────────────────────────────
ENVIRONMENT=production
# Same-origin deployments (the compose stack — nginx serves the frontend AND
# proxies /api) don't use CORS at all; this only matters for split-host
# setups, e.g. CORS_ORIGINS=["https://yourapp.vercel.app"]. Local dev:
# CORS_ORIGINS=["http://localhost:5173"]
CORS_ORIGINS=["http://localhost:5173"]
LOG_LEVEL=INFO

# ── Access mode ────────────────────────────────────────────────────────────────
# Seed/fallback value only — once the app has run its migrations, open-access
# mode is controlled live from the admin portal (Platform tab), and that
# setting is authoritative. Open access (true) = anyone can register and use
# the app, self-hosted model included, with no promo code, subscription, or
# billing — the default, and the right mode for self-hosting, provisioning
# accounts for a team/company, or a free community server. Untick the portal
# checkbox for gated SaaS mode (promo codes / Stripe — see Billing below).
OPEN_ACCESS_MODE=true

# ── Optional integrations (not needed for self-hosting) ──────────────────────
# Email (Resend, for welcome/password-reset mail): see docs/EMAIL_SETUP.md for
#   RESEND_API_KEY / RESEND_FROM_EMAIL. Without them nothing is sent (a
#   warning is logged) and registration/reset flows still work.
# Billing (running Lorekeeper as a gated PAID service) requires a commercial
#   license — contact hello@harrisonsmith.ai for the license and the Stripe
#   setup guide. Without it, billing routes return a clear 503 and everything
#   else works.

# ── Admin ─────────────────────────────────────────────────────────────────────
# OPTIONAL override — the first account registered on a fresh deployment
# becomes the admin automatically, so most self-hosters never set this.
# When set, the account with this exact email is ALSO always treated as
# admin (a recovery hatch if the admin flag is ever lost). Additional admins
# can be promoted from the admin portal's Users tab.
ADMIN_EMAIL=

# ── Dev compose port binding ──────────────────────────────────────────────────
# Host interface that docker-compose.yml / docker-compose.dev.yml publish
# postgres, valkey, backend and vite on. Unset (or empty) = 127.0.0.1, so
# nothing is reachable from the LAN. For remote dev, set it to ONE specific
# interface such as your machine's Tailscale IP (`tailscale ip -4`). Must be
# an IPv4 address (an unbracketed IPv6 address breaks the port spec).
# Setting it REPLACES loopback: local clients on this machine (psql, a natively
# run backend, scripts/start.sh) must then connect to the BIND_IP address too.
# NEVER use 0.0.0.0: Docker-published ports bypass host firewalls such as
# ufw/firewalld on Linux, exposing Postgres, Valkey, the backend API and Vite
# to your whole network.
# docker-compose.prod.yml ignores this (only nginx publishes 80/443).
# BIND_IP=

# ── Cloud Deployment ──────────────────────────────────────────────────────────
# VITE_API_URL is a BUILD-TIME variable for the frontend, not a server env var.
# Only needed when the frontend is deployed separately from the backend
# (e.g., Vercel frontend + VPS/Railway backend on a different domain).
#
# When using docker-compose.prod.yml on a single server (nginx proxies /api),
# leave this unset — the frontend uses relative /api/ URLs automatically.
#
# When deploying to Vercel:
#   1. Set VITE_API_URL in Vercel project → Settings → Environment Variables.
#   2. Set CORS_ORIGINS above to include your Vercel app URL.
# VITE_API_URL=https://your-backend.example.com

# ── Local LLM gate (app/core/llm_gate.py) ─────────────────────────────────────
# The one model every platform-LLM task uses, so Ollama never reloads (empty = KOBOLD_MODEL).
LOCAL_LLM_MODEL=
# Seconds a request waits for a local-LLM slot before a 503 llm_busy.
LLM_GATE_WAIT_S=60
# Concurrent local-LLM calls the gate admits; keep equal to Ollama's own setting.
# The bundled ollama container is fixed at 1 (its 5.25g limit holds one KV
# cache), so leave this at 1 unless KOBOLD_URL points at a bigger server.
OLLAMA_NUM_PARALLEL=1
# LLM_GATE_CAPACITY=1  # explicit gate-only override; wins over OLLAMA_NUM_PARALLEL
# Context window (tokens) the local model is loaded with; prompt budgets fit under it.
# Keep equal to Ollama's own OLLAMA_CONTEXT_LENGTH.
OLLAMA_CONTEXT_LENGTH=4096

# ── Edition, image tag and upgrade backups (E0-Platform.9) ────────────────────
# agpl (default) or commercial. scripts/deploy-oci.sh adds the `tts` profile
# to COMPOSE_PROFILES for agpl, and refuses to deploy commercial with `tts`
# in COMPOSE_PROFILES (AD-16: the commercial build uses browser speech).
LOREKEEPER_EDITION=agpl
# Compose profiles to run (comma-separated); deploy-oci.sh applies the rule above.
# COMPOSE_PROFILES=
# Tag of the images built from source (lorekeeper-web/ml/stt/nginx:<tag>).
# Unset: deploy-oci.sh uses `git describe`, else `latest`. Set one per
# release (e.g. v1.2) so the previous release's images stay on the host for a
# rollback (docs/OCI_DEPLOYMENT.md, "Rolling back"). Nothing is ever pushed.
# LOREKEEPER_TAG=
# Before a migration on a database with data, the web service writes
# pre-upgrade_<UTC stamp>_<revision>.dump to the `backups` volume and keeps
# the newest this many (scripts/boot_migrate.py).
PRE_UPGRADE_BACKUPS_KEEP=5
