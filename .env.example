# =============================================================================
# Lorekeeper — Environment Variables
# Copy this file to .env before starting the app: `cp .env.example .env`
#
# Defaults below are for the STANDARD SELF-HOSTED SETUP — the full Docker
# Compose stack (docker-compose.prod.yml), where postgres/redis/ollama are
# sibling containers reached by their service names. If that's you, the only
# things you MUST change are:
#   1. SECRET_KEY        (generate with: openssl rand -hex 32)
#   2. POSTGRES_PASSWORD (pick anything strong; keep it in DATABASE_URL too)
#   3. ADMIN_EMAIL       (the email you'll register with — unlocks the admin
#                         portal, where you install the AI model in one click)
#
# Running the backend directly on your machine for development instead? Use
# the "local dev" alternatives noted next to each service below.
# =============================================================================

# ── Database ──────────────────────────────────────────────────────────────────
# Compose stack: host is the `postgres` service name. Local dev: localhost.
# The password here MUST match POSTGRES_PASSWORD below.
DATABASE_URL=postgresql+asyncpg://lorekeeper:changeme@postgres:5432/lorekeeper
POSTGRES_USER=lorekeeper
POSTGRES_PASSWORD=changeme
POSTGRES_DB=lorekeeper
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ── Redis ─────────────────────────────────────────────────────────────────────
# Compose stack: `redis` service name. Local dev: redis://localhost:6379/0
REDIS_URL=redis://redis:6379/0

# ── Auth (generate with: openssl rand -hex 32) ────────────────────────────────
SECRET_KEY=REPLACE_WITH_SECURE_RANDOM_KEY
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── Default LLM (users can override per-account in Settings) ──────────────────
# The compose stack ships an Ollama container at http://ollama:11434 — leave
# this as-is and install the model from Admin → System after first login.
# Despite the name, KOBOLD_URL just needs an OpenAI-compatible
# chat-completions endpoint (or KoboldCpp's native API), so alternatives work:
#   - KoboldCpp/Ollama on the Docker HOST machine (e.g. your GPU desktop):
#     KOBOLD_URL=http://host.docker.internal:5001
#   - Local dev outside Docker: KOBOLD_URL=http://localhost:11434
# If you run neither, users can configure OpenAI / Anthropic / Gemini keys
# from their account Settings page instead.
KOBOLD_URL=http://ollama:11434
# Generous timeout: a 7B model on CPU can legitimately take minutes on long
# generations. With a GPU, replies are seconds and this never matters.
KOBOLD_TIMEOUT_SECONDS=600
KOBOLD_MAX_LENGTH=800
KOBOLD_TEMPERATURE=0.72
KOBOLD_TOP_P=0.95

# ── App ───────────────────────────────────────────────────────────────────────
ENVIRONMENT=production
# Same-origin deployments (the compose stack — nginx serves the frontend AND
# proxies /api) don't use CORS at all; this only matters for split-host
# setups, e.g. CORS_ORIGINS=["https://yourapp.vercel.app"]. Local dev:
# CORS_ORIGINS=["http://localhost:5173"]
CORS_ORIGINS=["http://localhost:5173"]
LOG_LEVEL=INFO

# ── Access mode ────────────────────────────────────────────────────────────────
# Seed/fallback value only — once the app has run its migrations, open-access
# mode is controlled live from the admin portal (Platform tab), and that
# setting is authoritative. Open access (true) = anyone can register and use
# the app, self-hosted model included, with no promo code, subscription, or
# billing — the default, and the right mode for self-hosting, provisioning
# accounts for a team/company, or a free community server. Untick the portal
# checkbox for gated SaaS mode (promo codes / Stripe — see Billing below).
OPEN_ACCESS_MODE=true

# ── Billing (Stripe subscriptions) ─────────────────────────────────────────────
# Only relevant when OPEN_ACCESS_MODE=false.
# All optional — the app runs fine without these (promo-code-only mode); billing
# routes return a clear 503 until they're set. Full walkthrough for getting these
# values: docs/PAYMENT_PROCESSOR_SETUP.md
FRONTEND_URL=http://localhost:5173
# Use a Restricted API Key (rk_...), not the full Secret Key — see the exact
# permission set to grant it in docs/PAYMENT_PROCESSOR_SETUP.md step 3.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Two tiers, two Stripe Products, two Prices — see docs/PAYMENT_PROCESSOR_SETUP.md.
STRIPE_PRICE_ID_BYOK=      # $5/mo — bring your own OpenAI/Anthropic/Gemini/custom key
STRIPE_PRICE_ID_HOSTED=    # $15/mo — metered access to Lorekeeper's own hosted model
# Rough chars/4 estimate of hosted-model usage a "hosted"-tier subscriber gets
# per billing period before they need their own API key for the rest of it —
# see app/services/billing_service.py's estimate_tokens docstring for why
# it's an estimate, not an exact provider-reported count. Not applicable to
# the "byok" tier, which never gets hosted-model access at any price.
SUBSCRIPTION_MONTHLY_TOKEN_QUOTA=1000000

# ── Email (Resend) ──────────────────────────────────────────────────────────
# All optional — without RESEND_API_KEY set, registration/checkout/password
# reset all still work, they just don't send anything (a warning is logged
# instead). Full walkthrough: docs/EMAIL_SETUP.md.
RESEND_API_KEY=
# Must be an address on a domain verified in Resend's dashboard.
RESEND_FROM_EMAIL=Lorekeeper <noreply@lorekeeper.quest>
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=60

# ── Admin ─────────────────────────────────────────────────────────────────────
# The email address that gets the admin portal (user management, promo codes,
# platform settings, model install, logs/support bundle). Set it BEFORE
# registering, then register an account with this exact email. Additional
# admins can be promoted from the portal afterward. Unset means nobody is
# admin until one is granted directly in the database.
ADMIN_EMAIL=you@example.com

# ── Cloud Deployment ──────────────────────────────────────────────────────────
# VITE_API_URL is a BUILD-TIME variable for the frontend, not a server env var.
# Only needed when the frontend is deployed separately from the backend
# (e.g., Vercel frontend + VPS/Railway backend on a different domain).
#
# When using docker-compose.prod.yml on a single server (nginx proxies /api),
# leave this unset — the frontend uses relative /api/ URLs automatically.
#
# When deploying to Vercel:
#   1. Set VITE_API_URL in Vercel project → Settings → Environment Variables.
#   2. Set CORS_ORIGINS above to include your Vercel app URL.
# VITE_API_URL=https://your-backend.example.com
